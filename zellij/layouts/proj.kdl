layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="status-bar"
        }
    }

    // Initial tab starts an interactive fish shell that immediately runs
    // the `proj` project picker. Picking a project opens it in a new tab;
    // this tab stays around as a plain shell / picker.
    tab name="proj" {
        pane command="fish" {
            args "-C" "proj"
        }
    }
}
